{
  "entities": {
    "PlayerDirectoryEntry": {
      "title": "PlayerDirectoryEntry",
      "description": "Public non-PII tactical profile and leaderboard entry keyed by unique STK player ID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shortId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^STK-[0-9]{6}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "bannerId": {
          "type": "string",
          "enum": ["mirage-gold", "nuke-reactor", "cyber-cobalt", "crimson-ops", "shadow-elite", "emerald-spec"]
        },
        "authProvider": {
          "type": "string",
          "enum": ["guest", "google", "apple"]
        },
        "kills": {
          "type": "integer"
        },
        "deaths": {
          "type": "integer"
        },
        "wins": {
          "type": "integer"
        },
        "matchesPlayed": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "shortId",
        "displayName",
        "bannerId",
        "authProvider",
        "kills",
        "deaths",
        "wins",
        "matchesPlayed",
        "score",
        "createdAt",
        "updatedAt"
      ]
    },
    "PrivatePlayerAccount": {
      "title": "PrivatePlayerAccount",
      "description": "Private player wallet, unlocked skins/FX, and linked auth metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shortId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^STK-[0-9]{6}$"
        },
        "credits": {
          "type": "integer"
        },
        "equippedSkin": {
          "type": "string",
          "maxLength": 32
        },
        "equippedHitFx": {
          "type": "string",
          "maxLength": 32
        },
        "equippedKillFx": {
          "type": "string",
          "maxLength": 32
        },
        "unlockedSkins": {
          "type": "array"
        },
        "unlockedHitFx": {
          "type": "array"
        },
        "unlockedKillFx": {
          "type": "array"
        },
        "casesOpened": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "shortId",
        "credits",
        "equippedSkin",
        "equippedHitFx",
        "equippedKillFx",
        "unlockedSkins",
        "unlockedHitFx",
        "unlockedKillFx",
        "casesOpened",
        "createdAt",
        "updatedAt"
      ]
    },
    "FriendEntry": {
      "title": "FriendEntry",
      "description": "Saved friend reference in a user's private friend subcollection.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "friendUid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "friendShortId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^STK-[0-9]{6}$"
        },
        "friendName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "friendBannerId": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "friendUid",
        "friendShortId",
        "friendName",
        "friendBannerId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/playerDirectory/{shortId}": {
      "schema": { "$ref": "#/entities/PlayerDirectoryEntry" },
      "description": "Public tactical profile & leaderboard stats indexed by unique STK-XXXXXX ID."
    },
    "/players/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PrivatePlayerAccount" },
      "description": "Owner-only wallet, unlocked cosmetics, and account profile."
    },
    "/players/{userId}/friends/{friendId}": {
      "schema": { "$ref": "#/entities/FriendEntry" },
      "description": "Owner-only saved friends list for squad play."
    }
  }
}
